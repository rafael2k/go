# Native dist tests for plan9/arm64.

share=/n/dos
goroot=/tmp/goroot
go=$goroot/bin/go

fn setupnet {
	echo TEST network-setup
	if(! test -e /srv/cs && ! test -e /net/cs) {
		ndb/cs
		sleep 1
	}
	ip/ipconfig loopback /dev/null 127.0.0.1 255.0.0.0
	echo network-setup loopback4 $status
	ip/ipconfig loopback /dev/null ::1 /128
	echo network-setup loopback6 $status
	if(test -e /net/ndb) {
		echo network-setup /net/ndb
		cat /net/ndb
	}
	echo DONE network-setup $status
}

fn setupswap {
	echo TEST swap-setup
	swapfile=/tmp/swap
	swapmb=1024
	if(! test -e $swapfile) {
		echo creating $swapmb MB swap at $swapfile
		# hjfs free space inside the 9front image is ~2 GiB so keep this modest.
		dd -if /dev/zero -of $swapfile -bs 1048576 -count $swapmb
	}
	swap $swapfile
	echo DONE swap-setup $status
}

fn setupgoroot {
	echo TEST dist-goroot-copy
	if(test -e $goroot) {
		rm -rf $goroot
	}
	mkdir -p $goroot
	dircp $share $goroot
	chmod 775 $goroot/bin/* $goroot/pkg/tool/plan9_arm64/*
	echo DONE dist-goroot-copy $status
}

fn rundist {
	echo TEST dist $*
	GOENV=off GOROOT=$goroot GOCACHE=/tmp/gocache GOTMPDIR=/tmp/gotmp GOPATH=/nonexist-gopath $go tool dist test -v -k $*
	echo DONE dist $status
}

setupnet
setupswap
setupgoroot

if(~ $#* 0) {
	rundist
}
if not {
	rundist $*
}
