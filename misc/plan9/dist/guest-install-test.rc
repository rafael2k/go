# Smoke-test guest script for misc/plan9/dist/install-go.rc.
#
# Invoked inside a 9front QEMU guest after the harness has mounted the
# share at /n/dos.  The share must contain install-go.rc at its root.

echo TEST install-go.rc

# --- network setup ------------------------------------------------------
# 9front's boot sequence starts ndb/cs (and sometimes ndb/dns) before any
# IP interface exists, so dnsipvers stays 0 forever and they refuse to
# resolve anything ("cs: no ip address").  Tear them down, bring up the
# interfaces, then restart cs/dns/webfs so they see the new netconfig.
kill cs | rc >[2]/dev/null
kill dns | rc >[2]/dev/null
kill webfs | rc >[2]/dev/null
sleep 1

ip/ipconfig loopback /dev/null 127.0.0.1 255.0.0.0
echo network-setup loopback4 $status
ip/ipconfig loopback /dev/null ::1 /128
echo network-setup loopback6 $status

if(test -e /net/ether0){
	ip/ipconfig ether /net/ether0
	echo network-setup dhcp $status
}
sleep 2

ndb/cs
sleep 1
ndb/dns -r
sleep 2

echo network-setup /net/ndb:
cat /net/ndb >[2]/dev/null

# --- run the installer --------------------------------------------------
# Exercise the canonical "hget URL | rc" one-liner against the live
# webroot, not just `rc /path/to/install-go.rc`.  This catches things
# like webfs needing to be killed/restarted, $argv0 differences, and
# pipe-into-rc positional-arg handling -- the exact path real users hit.
echo TEST install-go.rc-run
goroot=/tmp/go-install-smoke
if(test -e $goroot)
	rm -rf $goroot

# webfs comes up wedged in the smoke test image, so prime it here too;
# the installer also does this but doing it upfront makes the failure
# mode of `hget install-go.rc` easier to read.
kill webfs | rc >[2]/dev/null
sleep 1
webfs -T 1200000
sleep 1

# 9front's rc(1) has no `--` flag-end and does not let positional args
# follow the script on stdin, so pipe into `rc -c '. /fd/0 args...'`
# instead: the dot builtin sources the script and forwards its argv.
hget https://sdrtelecom.com.br/go-plan9/install-go.rc \
	| rc -c '. /fd/0 -y -goroot '$goroot
echo TEST install-go.rc-run $status

# --- post-install verification -----------------------------------------
echo TEST install-go.rc-verify
if(! test -x $goroot/bin/go){
	echo install-test: $goroot/bin/go missing >[1=2]
	exit missing
}
GOROOT=$goroot GOENV=off GOPATH=/tmp/install-go.gopath $goroot/bin/go version
echo TEST install-go.rc-verify $status

# --- small "hello world" build smoke test ------------------------------
echo TEST install-go.rc-build
mkdir -p /tmp/hello
cd /tmp/hello
cat > main.go <<'EOF'
package main

import "fmt"

func main() { fmt.Println("hello plan9 from install-go.rc smoke test") }
EOF
GOROOT=$goroot GOENV=off GOPATH=/tmp/install-go.gopath GOCACHE=/tmp/install-go.gocache GOTMPDIR=/tmp $goroot/bin/go build -o /tmp/hello/hello main.go
echo build $status
/tmp/hello/hello
echo run $status
echo TEST install-go.rc-build DONE

echo DONE install-go.rc smoke test
